{
  "compilerOptions": {
    "target": "ES6",
    "module": "esnext",
    "lib": ["ES6"],
    "outDir": "./dist/server",
    "sourceMap": true,
    "declaration": true,
    "declarationDir": "./dist/server/types",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmitHelpers": true,
    "importHelpers": true,
    "rootDir": "./src",
    "baseUrl": ".", 
    "paths": {
      "@nostrwatch/nocap": ["node_modules/@nostrwatch/nocap/dist/web/index.d.ts"],
      "@nostrwatch/*": ["node_modules/@nostrwatch/*/src"]
    }
  },
  "include": ["@nostrwatch/nocap.d.ts", "src/**/*"],
  "exclude": ["node_modules", "dist"],
  "tsc-alias": {
    "resolveFullPaths": true,
    "resolveFullExtension": ".js"
  }
}

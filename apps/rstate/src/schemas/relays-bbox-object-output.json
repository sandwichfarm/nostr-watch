{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "relays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "RelayState objects (detailed or full)"
    },
    "bbox": {
      "type": "object",
      "properties": {
        "sw": {
          "type": "object",
          "properties": { "lat": { "type": "number" }, "lon": { "type": "number" } },
          "required": ["lat", "lon"]
        },
        "ne": {
          "type": "object",
          "properties": { "lat": { "type": "number" }, "lon": { "type": "number" } },
          "required": ["lat", "lon"]
        }
      },
      "required": ["sw", "ne"]
    },
    "total": { "type": "number" },
    "limit": { "type": "number" },
    "offset": { "type": "number" }
  },
  "required": ["relays", "bbox", "total", "limit", "offset"]
}

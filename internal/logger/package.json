{
  "name": "@nostrwatch/logger",
  "version": "0.0.9",
  "description": "A logging wrapper",
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "import": "./dist/server/index.esm.js",
        "require": "./dist/server/index.cjs.js",
        "types": "./dist/types/index.d.ts"
      },
      "browser": {
        "import": "./dist/browser/index.esm.js",
        "types": "./dist/types/index.d.ts"
      },
      "default": {
        "import": "./dist/browser/index.esm.js",
        "types": "./dist/types/index.d.ts"
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && rollup -c && pnpm run build:types",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "rollup -c --watch",
    "test": "vitest",
    "lint": "eslint . --ext .ts",
    "prepare": "pnpm run clean && pnpm run build"
  },
  "keywords": [
    "logger",
    "logging"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "dependencies": {
    "debug": "4.3.7",
    "logging": "3.3.0",
    "power-assert": "^1.6.1",
    "winston": "3.14.2"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "5.1.1",
    "@rollup/plugin-commonjs": "28.0.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.0",
    "@rollup/plugin-replace": "6.0.1",
    "@rollup/plugin-terser": "0.4.4",
    "@surma/rollup-plugin-off-main-thread": "2.2.3",
    "@types/debug": "4.1.12",
    "@types/glob": "^8.1.0",
    "@types/node": "22.7.4",
    "@types/power-assert": "^1.5.12",
    "@types/winston": "2.4.4",
    "@typescript-eslint/eslint-plugin": "8.6.0",
    "@typescript-eslint/parser": "8.6.0",
    "@web/rollup-plugin-import-meta-assets": "^2.2.1",
    "eslint": "9.11.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "prettier": "3.3.3",
    "rimraf": "^5.0.0",
    "rollup": "^4.24.0",
    "rollup-plugin-livereload": "2.0.5",
    "rollup-plugin-node-polyfills": "0.2.1",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-typescript2": "0.36.0",
    "rollup-plugin-web-worker-loader": "1.6.1",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^0.34.1",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=14.0.0"
  }
}

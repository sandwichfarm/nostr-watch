{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"baseUrl": "./",
		"paths": {
			"@nostrwatch/*": ["../../libraries/*/dist"],
			"$stores/*": ["src/lib/stores/*"],
			"$utils/*": ["src/lib/utils/*"],
			"$ui/*": ["src/lib/components/ui/*"],
			"$components/*": ["src/components/*"],
			"$layouts/*": ["src/layouts/*"],
			"$routes/*": ["src/routes/*"],
			"$lib/*": ["src/lib/*"],
			"src/*": ["src/*"]
		},
	}
}
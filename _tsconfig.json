{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@nostrwatch/*": ["./node_modules/@nostrwatch/*/src"],
    },
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

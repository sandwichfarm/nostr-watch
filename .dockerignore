# Exclude everything by default
*

# Include relaymon app
!apps/relaymon/

# Include workspace dependencies (referenced by apps/relaymon/deno.json import map)
!libraries/nocap/
!libraries/websocket/
!libraries/db/
!libraries/nostrings/
!internal/utils/
!internal/publisher/
!internal/logger/
!internal/announce/

# Re-exclude heavy/unnecessary content in included dirs
**/node_modules/
**/dist/
**/tests/
**/*.db
**/*.env*

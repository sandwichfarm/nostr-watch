{
    "compilerOptions": {
      "lib": ["deno.ns", "deno.window", "esnext"],
      "strict": true,
      "vendor": true,
    },
    "vendor": true,
    "nodeModulesDir": "auto",
    "tasks": {
      "force-refresh": "rm -rf node_modules && rm -f deno.lock && DENO_DIR=$(deno info --json | jq -r .denoDir) && rm -rf \"$DENO_DIR/npm\" && deno task start",
      "compile": "mkdir -p dist && deno compile --no-check --allow-ffi --unstable-sloppy-imports --allow-net --allow-env --allow-read --allow-write --allow-run --output dist/trawler src/main.ts",
      "start": "deno run --allow-sys --allow-ffi --unstable-sloppy-imports --allow-net --allow-env --allow-read --allow-write --allow-run src/main.ts",
      "test": "deno test --unstable-sloppy-imports --allow-net --allow-env --allow-read --allow-write --allow-run",
      "link:nocap": "bash -c 'REPO_ROOT=$(cd ../.. && pwd) && if ! [ -L ./node_modules/@nostrwatch/nocap ]; then ln -sfn \"$REPO_ROOT/libraries/nocap\" ./node_modules/@nostrwatch/nocap; fi'"
    },
    "fmt": {
      "files": {
        "include": ["**/*.ts", "**/*.js", "**/*.json", "**/*.yaml", "**/*.yml"]
      }
    },
    "lint": {
      "files": {
        "include": ["**/*.ts", "**/*.js"]
      }
    },
    "version": "0.2.0",
    "imports": {
      "nostr-geotags": "https://esm.sh/nostr-geotags@latest",
      "npm:nostr-fetch": "npm:nostr-fetch@0.13.1",
      "npm:nostr-tools": "npm:nostr-tools@1.17.0",
      "nostr-tools": "npm:nostr-tools@1.17.0",
      "nostr-tools/pure": "https://esm.sh/nostr-tools@2.10.4/pure",
      "nostr-tools/nip19": "npm:nostr-tools@1.17.0/nip19",
      "npm:murmurhash": "https://esm.sh/murmurhash@latest",
      "npm:p-queue": "https://esm.sh/p-queue@latest",
      "npm:chalk": "https://esm.sh/chalk@latest",
      "npm:cross-fetch": "https://esm.sh/cross-fetch@latest",
      "@noble/hashes/utils": "https://esm.sh/@noble/hashes@1.3.2/utils",
      "ws": "https://deno.land/x/ws@v1.0.0/mod.ts",
      "murmurhash": "https://esm.sh/murmurhash@latest",
      "promise-deferred": "https://esm.sh/promise-deferred@latest",
      "npm:promise-deferred": "https://esm.sh/promise-deferred@latest",
      "cross-fetch": "https://esm.sh/cross-fetch@latest",

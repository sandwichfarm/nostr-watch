{
	"name": "@nostrwatch/gui",
	"description": "",
	"version": "0.6.78",
	"private": true,
	"license": "MIT",
	"keywords": [
		"svelte",
		"sveltekit",
		"data",
		"table",
		"datatable",
		"grid",
		"sort",
		"filter",
		"paginate"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sandwichfarm/nostr-watch"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "rm -rf dist && vite build -c vite.production.js",
		"seed": "node ./scripts/generate-seed.mjs",
		"deploy:bunny": "node ./scripts/deploy-bunny.mjs",
		"deploy:seeded:bunny": "pnpm run build:seeded && pnpm run deploy:bunny",
		"nip05": "node ./scripts/generate-nip05.mjs",
		"nip66:config": "node ./scripts/generate-nip66-config.mjs",
		"prebuild": "pnpm run nip05 && pnpm run nip66:config",
		"build:seeded": "pnpm run seed && pnpm run build",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && node ./scripts/check-svelte-baseline.mjs",
		"check:raw": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"lint": "node ./scripts/check-prettier-baseline.mjs",
		"lint:raw": "prettier --check .",
		"baseline:check": "svelte-kit sync && node ./scripts/check-svelte-baseline.mjs --update",
		"baseline:lint": "node ./scripts/check-prettier-baseline.mjs --update",
		"format": "prettier --write ."
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/components/**",
		"!dist/utils.*"
	],
	"peerDependencies": {
		"svelte": "^5"
	},

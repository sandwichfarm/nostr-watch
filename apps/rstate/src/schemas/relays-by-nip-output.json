{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nip": { "type": "number" },
          "count": { "type": "number" },
          "avgSupport": { "type": "number" },
          "relays": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["nip", "count", "avgSupport"]
      }
    }
  },
  "required": ["groups"]
}


{
  "name": "@nostrwatch/nip66",
  "version": "0.0.1",
  "description": "A NIP-66 implementation written in typescript.",
  "main": "dist/server/bundle.js",
  "browser": "dist/browser/bundle.js",
  "types": "dist/types/index.d.ts",
  "keywords": [
    "nostr",
    "NIP-66",
    "NIP66",
    "relay",
    "relays",
    "relay-liveness",
    "monitor",
    "liveness"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.46.0",
    "prettier": "^3.0.0",
    "ts-loader": "^9.4.4",
    "typescript": "^5.0.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0",
    "worker-loader": "^3.0.8"
  },
  "scripts": {
    "build": "npm run clean && webpack --config webpack.config.js",
    "build:browser": "webpack --config webpack.config.js --env target=browser",
    "build:server": "webpack --config webpack.config.js --env target=server",
    "clean": "rm -rf dist",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,md}'",
    "test": "jest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "jwt-encode": "1.0.1",
    "nostr-tools": "2.7.2"
  },
  "peerDependencies": {},
  "files": [
    "dist",
    "adapters"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandwichfarm/nostr-watch.git"
  },
  "bugs": {
    "url": "https://github.com/sandwichfarm/nostr-watch/issues"
  },
  "homepage": "https://github.com/sandwichfarm/nostr-watch/tree/next/libraries/nip66#readme"
}

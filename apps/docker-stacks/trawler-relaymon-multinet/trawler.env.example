# Trawler — Environment Variables (trawler-relaymon-multinet stack)
# Copy to trawler.env if you want to set environment overrides for trawler.
# Note: This stack's docker-compose.yaml does not mount a trawler .env by default.
# To use it, add an env_file entry to the trawler service in docker-compose.yaml:
#   env_file:
#     - ./trawler.env

# Daemon identity for publishing trawled relay lists
DEAMON_PUBKEY=
DEAMON_PRIVKEY=

# Redis connection (optional — only needed if using queue features)
#REDIS_HOST=localhost
#REDIS_PORT=6379
#REDIS_DB=0
#REDIS_PASSWORD=
#REDIS_LOGLEVEL=warning

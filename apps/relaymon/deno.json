{
    "compilerOptions": {
      "lib": ["deno.ns", "deno.window", "esnext"],
      "strict": true
    },
    "nodeModulesDir": "auto",
    "importMap": "./import_map.json",
    "tasks": {
      "start": "deno run --allow-ffi --unstable-sloppy-imports --allow-net --allow-env --allow-read --allow-write main.ts",
      "test": "deno test --unstable-sloppy-imports --allow-net --allow-env --allow-read --allow-write",
      "link:nocap": "bash -c 'if ! [ -L ./node_modules/@nostrwatch/nocap ]; then ln -sfn /Users/sandwich/Develop/nostr-watch/libraries/nocap ./node_modules/@nostrwatch/nocap; fi'",
      "status": "deno run --allow-net --allow-env --allow-read --allow-write status.ts"
    },
    "fmt": {
      "files": {
        "include": ["**/*.ts", "**/*.js", "**/*.json", "**/*.yaml", "**/*.yml"]
      }
    },
    "lint": {
      "files": {
        "include": ["**/*.ts", "**/*.js"]
      }
    },
    "version": "0.1.0",
    "imports": {
      "npm:nostr-fetch": "npm:nostr-fetch@0.17.0"
    }
}
  
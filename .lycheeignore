# Relay URLs — may be offline, used in code examples
^wss://
# Badge services — rate-limit frequently
^https://img\.shields\.io
^https://badge\.fury\.io
# npm — sometimes flaky in CI
^https://www\.npmjs\.com/package/
# Root-relative doc site links — resolved by VitePress, not valid as filesystem paths
^/architecture
^/getting-started
^/packages
# Local planning artifacts — intentionally absent from CI checkouts and package docs
^file://.*/\.planning/
# localhost dev server — not available in CI
^http://localhost

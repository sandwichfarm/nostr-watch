{
    "name": "@nostrwatch/memory-relay",
    "version": "1.3.0",
    "description": "A simple memory relay",
    "type": "module",
    "main": "dist/esm/index.mjs",
    "types": "dist/esm/index.d.ts",
    "module": "src/index.ts",
    "repository": "https://github.com/sandwichfarm/nostr-watch",
    "author": "Sandwich",
    "license": "MIT",
    "scripts": {
      "clean": "rm -rf dist",
      "tsc": "tsc",
      "build": "pnpm clean && pnpm tsc && pnpm run build:esm",
      "build:esm": "esbuild src/index.ts --bundle --minify --sourcemap --outdir=dist/esm --format=esm --out-extension:.js=.mjs"
    },
    "files": [
      "src",
      "dist"
    ],
    "dependencies": {},
    "devDependencies": {
      "esbuild": "^0.24.0",
      "typescript": "^5.2.2"
    },
    "peerDependencies": {
      "@nostrwatch/utils": "workspace:^",
      "@nostrwatch/route66": "workspace:^",
      "nostr-tools": "^2.10.4"
    }
  }
  
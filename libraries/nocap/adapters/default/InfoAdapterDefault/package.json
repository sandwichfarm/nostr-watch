{
  "name": "@nostrwatch/nocap-info-adapter-default",
  "version": "1.1.4",
  "type": "module",
  "license": "MIT",

  "main": "dist/server/index.js",
  "browser": "dist/web/index.js",
  "types": "dist/types/index.d.ts",

  "scripts": {
    "build": "yarn clean && yarn build:server && yarn build:web",
    "build:server": "tsc --project tsconfig.server.json",
    "build:web": "webpack --config webpack.web.config.cjs",
    "dev:server": "webpack --config webpack.server.config.cjs --watch",
    "dev:web": "webpack --config webpack.web.config.cjs --watch",
    "clean": "rimraf dist",
    "prepare": "yarn clean && yarn build",
    "lint": "eslint . --ext .ts",
    "test": "vitest",
    "test-ui": "vitest --ui --testTimeout=15000"
  },

  "dependencies": {
    "ajv": "8.17.1",
    "cross-fetch": "4.0.0"
  },

  "devDependencies": {
    "@nostrwatch/nocap": "*",
    "@babel/plugin-transform-modules-commonjs": "7.23.3",
    "@types/promise-deferred": "2.0.5",
    "@vitest/ui": "0.34.6",
    "node-polyfill-webpack-plugin": "4.0.0",
    "vitest": "0.34.6",
    "vitest-nostr": "0.4.1"
  }
}
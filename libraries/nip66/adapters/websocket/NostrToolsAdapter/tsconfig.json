{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "lib": ["ES2021", "DOM"],
    "declaration": true,
    "declarationDir": "dist/types",
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist/node",
    "rootDir": "src",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": false,
    "resolveJsonModule": true,
    "baseUrl": "./",
    "paths": {
      "@noble/*": ["node_modules/@noble/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "../../../src"],
  "files": ["./src/index.ts"]
}

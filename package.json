{
  "name": "@nostrwatch/monorepo",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "prerelease": "./scripts/prerelease.sh",
    "release": "yarn prerelease && ./scripts/release.sh",
    "dry-prerelease": "./scripts/prerelease.sh --dry-run",
    "postinstall": "yarn workspace @nostrwatch/announce build",
    "dev:setup": "node ./scripts/dev-link-deps.js",
    "packages:update": "node ./scripts/upkg.js",
    "deploy:nocapd@all": "ansible-playbook .ansible/nocapd/deploy.yaml -i .ansible/inventories/johannesburg -i .ansible/inventories/amsterdam -i .ansible/inventories/mumbai -i .ansible/inventories/newyork -i .ansible/inventories/saopaulo -i .ansible/inventories/seoul -i .ansible/inventories/siliconvalley -i .ansible/inventories/sydney",
    "deploy:nocapd@amsterdam": "ansible-playbook .ansible/nocapd/deploy.yaml -i .ansible/inventories/amsterdam",
    "deploy:nocapd@seoul": "ansible-playbook .ansible/nocapd/deploy.yaml -i .ansible/inventories/seoul",
    "deploy:nocapd@newyork": "ansible-playbook .ansible/nocapd/deploy.yaml -i .ansible/inventories/newyork",
    "deploy:nocapd@mumbai": "ansible-playbook .ansible/nocapd/deploy.yaml -i .ansible/inventories/mumbai",
    "deploy:nocapd@sydney": "ansible-playbook .ansible/nocapd/deploy.yaml -i .ansible/inventories/sydney",
    "deploy:nocapd@johannesburg": "ansible-playbook .ansible/nocapd/deploy.yaml -i .ansible/inventories/johannesburg",
    "deploy:nocapd@saopaulo": "ansible-playbook .ansible/nocapd/deploy.yaml -i .ansible/inventories/saopaulo",
    "deploy:nocapd@siliconvalley": "ansible-playbook .ansible/nocapd/deploy.yaml -i .ansible/inventories/siliconvalley",
    "deploy:nocapd@ghost": "ansible-playbook .ansible/nocapd/deploy.yaml -i .ansible/inventories/ghost  --ask-vault-pass",
    "deploy:nocapd/config@all": "ansible-playbook .ansible/nocapd/deploy-config.yaml -i .ansible/inventories/johannesburg -i .ansible/inventories/amsterdam -i .ansible/inventories/mumbai -i .ansible/inventories/newyork -i .ansible/inventories/saopaulo -i .ansible/inventories/seoul -i .ansible/inventories/siliconvalley -i .ansible/inventories/sydney -i .ansible/inventories/frankfurt",
    "deploy:nocapd/config@amsterdam": "ansible-playbook .ansible/nocapd/deploy-config.yaml -i .ansible/inventories/amsterdam",
    "deploy:nocapd/config@frankfurt": "ansible-playbook .ansible/nocapd/deploy-config.yaml -i .ansible/inventories/frankfurt",
    "deploy:nocapd/config@seoul": "ansible-playbook .ansible/nocapd/deploy-config.yaml -i .ansible/inventories/seoul",
    "deploy:nocapd/config@newyork": "ansible-playbook .ansible/nocapd/deploy-config.yaml -i .ansible/inventories/newyork",
    "deploy:nocapd/config@mumbai": "ansible-playbook .ansible/nocapd/deploy-config.yaml -i .ansible/inventories/mumbai",
    "deploy:nocapd/config@sydney": "ansible-playbook .ansible/nocapd/deploy-config.yaml -i .ansible/inventories/sydney",
    "deploy:nocapd/config@johannesburg": "ansible-playbook .ansible/nocapd/deploy-config.yaml -i .ansible/inventories/johannesburg",
    "deploy:nocapd/config@saopaulo": "ansible-playbook .ansible/nocapd/deploy-config.yaml -i .ansible/inventories/saopaulo",
    "deploy:nocapd/config@siliconvalley": "ansible-playbook .ansible/nocapd/deploy-config.yaml -i .ansible/inventories/siliconvalley",
    "deploy:nocapd/config@ghost": "ansible-playbook .ansible/nocapd/deploy-config.yaml -i .ansible/inventories/ghost --ask-vault-pass",
    "nukecache@all": "ansible-playbook .ansible/nocapd/nuke-cache.yaml -i .ansible/inventories/johannesburg -i .ansible/inventories/amsterdam -i .ansible/inventories/mumbai -i .ansible/inventories/newyork -i .ansible/inventories/saopaulo -i .ansible/inventories/seoul -i .ansible/inventories/siliconvalley -i .ansible/inventories/sydney"
  },
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@changesets/cli": "2.27.8",
    "yarn": "^1.22.0"
  },
  "workspaces": [
    "apps/*",
    "demos/*",
    "internal/*",
    "libraries/*",
    "libraries/nocap/adapters/**/*",
    "libraries/kit/adapters/**/*",
    "libraries/adapters/**/*",
    "libraries/validators/**/*",
    "libraries/schemata/*"
  ],
  "useWorkspaces": true,
  "main": "index.js",
  "repository": "git@github.com:sandwichfarm/nostr-watch.git",
  "author": "dskvr <dskvr@users.noreply.github.com>",
  "license": "MIT"
}

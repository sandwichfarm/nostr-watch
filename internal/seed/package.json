{
  "name": "@nostrwatch/seed",
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "main": "dist/server/index.js",
  "browser": "dist/web/index.js",
  "types": "dist/server/index.d.ts",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:server",
    "build:server": "webpack --config webpack.server.config.cjs",
    "dev:server": "webpack --config webpack.server.config.cjs --watch",
    "test": "vitest",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf dist",
    "prepare": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@nostr-fetch/adapter-nostr-tools": "^0.15.1",
    "@nostrwatch/logger": "workspace:*",
    "@nostrwatch/utils": "workspace:*",
    "@nostrwatch/nwcache": "workspace:*",
    "cross-fetch": "^3.1.5",
    "js-yaml": "^4.1.0",
    "nostr-fetch": "^0.15.1",
    "nostr-tools": "1.17.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^0.34.1",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=14.0.0"
  }
}

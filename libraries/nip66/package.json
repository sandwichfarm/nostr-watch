{
  "name": "@nostrwatch/nip66",
  "version": "0.0.1",
  "description": "A NIP-66 implementation written in typescript.",
  "type": "module",
  "keywords": [
    "nostr",
    "NIP-66",
    "NIP66",
    "relay",
    "relays",
    "relay-liveness",
    "monitor",
    "liveness"
  ],
  "author": "bread@sandwich.farm",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/browser/index.esm.js",
      "require": "./dist/server/index.cjs.js"
    },
    "./*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/node/*.mjs",
      "require": "./dist/node/*.cjs"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/browser/core/index.esm.js",
      "require": "./dist/server/core/index.cjs.js"
    },
    "./interfaces": {
      "types": "./dist/types/interfaces/index.d.ts",
      "import": "./dist/browser/interfaces/index.esm.js",
      "require": "./dist/server/interfaces/index.cjs.js"
    },
    "./transform": {
      "types": "./dist/types/transform/index.d.ts",
      "import": "./dist/browser/transform/index.esm.js",
      "require": "./dist/server/transform/index.cjs.js"
    },
    "./models": {
      "types": "./dist/types/models/index.d.ts",
      "import": "./dist/browser/models/index.esm.js",
      "require": "./dist/server/models/index.cjs.js"
    },
    "./utils": {
      "types": "./dist/types/utils/index.d.ts",
      "import": "./dist/browser/utils/index.esm.js",
      "require": "./dist/server/utils/index.cjs.js"
    },
    "./factoryWorker": {
      "types": "./dist/types/factory/index.d.ts",
      "import": "./dist/browser/factory/index.esm.js",
      "require": "./dist/server/factory/index.cjs.js"
    },
    "./services": {
      "types": "./dist/types/services/index.d.ts",
      "import": "./dist/browser/services/index.esm.js",
      "require": "./dist/server/services/index.cjs.js"
    }
  },
  "dependencies": {
    "@nostrwatch/nocap": "workspace:^",
    "@nostrwatch/utils": "workspace:^",
    "@pabra/logger": "^1.2.0",
    "compress-json": "^3.1.0",
    "jsurl2": "^2.2.0",
    "jwt-encode": "1.0.1",
    "minisearch": "^7.1.0",
    "node-localstorage": "^3.0.5",
    "nostr-tools": "^2.10.3",
    "p-queue": "8.0.1",
    "queue": "7.0.0",
    "tseep": "^1.3.1",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "5.1.1",
    "@rollup/plugin-commonjs": "28.0.0",
    "@rollup/plugin-node-resolve": "15.3.0",
    "@rollup/plugin-replace": "6.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-wasm": "6.2.2",
    "@surma/rollup-plugin-off-main-thread": "2.2.3",
    "@types/node-localstorage": "^1.3.3",
    "esbuild": "^0.24.0",
    "esbuild-plugin-alias": "^0.2.1",
    "esbuild-plugin-clean": "^1.0.1",
    "eslint": "^8.46.0",
    "get-port": "7.1.0",
    "prettier": "^3.0.0",
    "rollup": "4.22.4",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-livereload": "2.0.5",
    "rollup-plugin-node-polyfills": "0.2.1",
    "rollup-plugin-off-main-thread": "1.1.0",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-terser": "7.0.2",
    "rollup-plugin-tsconfig-paths": "1.5.2",
    "rollup-plugin-typescript2": "0.36.0",
    "rollup-plugin-visualizer": "5.12.0",
    "rollup-plugin-web-worker-loader": "1.6.1",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.0.0"
  },
  "browser": {
    "crypto": false
  },
  "scripts": {
    "clean": "rm -rf dist",
    "clean:source": "find src -name \"*.d.ts\" -type f -delete && find src -name \"*.d.ts.map\" -type f -delete",
    "rollup": "rollup -c",
    "dev": "rollup -c --watch",
    "build": "pnpm run clean && pnpm run build:types && rollup -c && pnpm run clean:source",
    "build:types": "tsc -p tsconfig.json && tsc-alias",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,md}'",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandwichfarm/nostr-watch.git"
  },
  "bugs": {
    "url": "https://github.com/sandwichfarm/nostr-watch/issues"
  },
  "homepage": "https://github.com/sandwichfarm/nostr-watch/tree/next/libraries/nip66#readme"
}

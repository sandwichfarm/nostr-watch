{
  "name": "@nostrwatch/memory-relay",
  "version": "2.0.0",
  "description": "A simple memory relay",
  "type": "module",
  "main": "dist/esm/index.mjs",
  "types": "dist/index.d.ts",
  "module": "src/index.ts",
  "repository": "https://github.com/sandwichfarm/nostr-watch",
  "author": "Sandwich",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/esm/index.mjs"
    },
    "./abstract": {
      "types": "./dist/abstract.d.ts",
      "import": "./dist/esm/abstract.mjs",
      "default": "./dist/esm/abstract.mjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/esm/svelte.mjs",
      "default": "./dist/esm/svelte.mjs"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "tsc": "tsc",
    "build": "pnpm clean && pnpm tsc && pnpm node build.js",
    "build:esm": "node build.mjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/lodash": "^4",
    "esbuild": "^0.28.1",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "@nostrwatch/route66": "workspace:^",
    "@nostrwatch/utils": "workspace:^",
    "nostr-tools": "^2.10.4",
    "svelte": "^5.56.4",
    "tseep": "^1.3.1"
  }
}

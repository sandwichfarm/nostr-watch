{
	"name": "@nostrwatch/gui",
	"description": "",
	"version": "0.6.3",
	"license": "MIT",
	"keywords": [
		"svelte",
		"sveltekit",
		"data",
		"table",
		"datatable",
		"grid",
		"sort",
		"filter",
		"paginate"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/careswitch/svelte-data-table.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build -c vite.production.js",
		"preview": "yarn serve dist",
		"package": "svelte-kit sync && svelte-package && publint",
		"release": "changeset publish",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/components/**",
		"!dist/utils.*"
	],
	"peerDependencies": {
		"svelte": "^5"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.7",
		"@faker-js/faker": "^8.4.1",
		"@sveltejs/adapter-netlify": "^4.3.6",
		"@sveltejs/adapter-static": "^3.0.6",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.1",
		"@types/gh-pages": "^6",
		"@types/lodash": "^4",
		"bits-ui": "^0.21.16",
		"clsx": "^2.1.1",
		"gh-pages": "^6.2.0",
		"paneforge": "^0.0.6",
		"postcss": "^8.4.38",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"prettier-plugin-tailwindcss": "^0.6.4",
		"publint": "^0.2.0",
		"serve": "^14.2.4",
		"svelte": "^5.2.7",
		"svelte-check": "^3.6.0",
		"svelte-preprocess": "^6.0.3",
		"svelte-radix": "^1.1.0",
		"tailwind-merge": "^2.4.0",
		"tailwind-variants": "^0.2.1",
		"tailwindcss": "^3.4.4",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^5.0.11",
		"vite-plugin-copy": "^0.1.6",
		"vite-plugin-top-level-await": "^1.4.4",
		"vite-plugin-wasm": "^3.3.0",
		"vitest": "^2.0.0"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"dependencies": {
		"@careswitch/svelte-data-table": "^0.6.3",
		"@nostrwatch/nip66": "workspace:^",
		"@nostrwatch/nip66-cacheadapter-nostrsqlite": "workspace:^",
		"@nostrwatch/nip66-wsadapter-nostrtools": "workspace:^",
		"country-code-to-flag-emoji": "^1.3.3",
		"dexie": "^4.0.8",
		"lodash": "^4.17.21",
		"minisearch": "^7.1.0",
		"nostr-tools": "^2.10.3",
		"radix-svelte": "^0.9.0",
		"surrealdb": "^1.0.6",
		"svelte-time": "^0.9.0",
		"vite-plugin-compression": "^0.5.1"
	}
}

    "relay",
    "seeder"
  ],
  "author": "sandwich <sandwich@nostr.watch>",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.5",
    "esbuild": "^0.28.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@nostrwatch/db": "workspace:^",
    "@nostrwatch/nostrings": "workspace:^",
    "@nostrwatch/utils": "workspace:^",
    "better-sqlite3": "^9.2.2",
    "js-yaml": "^4.2.0",
    "nostr-fetch": "^0.15.1"
  }

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "relays": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Relay URL (format=simple)"
          },
          {
            "type": "object",
            "description": "RelayState object with optional distance field",
            "additionalProperties": true
          }
        ]
      }
    },
    "center": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" }
      },
      "required": ["lat", "lon"]
    },
    "radius": { "type": "number" }
  },
  "required": ["relays", "center", "radius"]
}


{
  "name": "@nostrwatch/nip66-cacheadapter-dexie",
  "version": "0.0.1",
  "description": "Dexie adapter for @nostrwatch/nip66",
  "type": "module",
  "author": "bread@sandwich.farm",
  "license": "MIT",
  "keywords": [
    "nostr",
    "NIP-66",
    "adapter",
    "cache",
    "LocalStorage"
  ],
  "exports": {
    ".": {
      "import": "./dist/browser/index.esm.js",
      "require": "./dist/browser/index.cjs.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist/workers",
    "dist/types",
    "dist/browser"
  ],
  "scripts": {
    "build": "yarn clean && yarn build:types && rollup -c",
    "build:types": "tsc --emitDeclarationOnly",
    "dev": "rollup -c --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "prepare": "yarn build"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "28.0.0",
    "@rollup/plugin-node-resolve": "15.3.0",
    "@rollup/plugin-replace": "6.0.1",
    "@rollup/plugin-terser": "0.4.4",
    "@surma/rollup-plugin-off-main-thread": "2.2.3",
    "esbuild": "0.24.0",
    "esbuild-plugin-inline-worker": "0.1.1",
    "eslint": "^8.46.0",
    "jest": "^29.6.1",
    "prettier": "^3.0.0",
    "rollup-plugin-cleandir": "3.0.0",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-livereload": "2.0.5",
    "rollup-plugin-node-polyfills": "0.2.1",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-terser": "7.0.2",
    "rollup-plugin-typescript2": "0.36.0",
    "rollup-plugin-visualizer": "5.12.0",
    "rollup-plugin-web-worker-loader": "1.6.1",
    "rollup-plugin-workers": "2.1.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@nostrwatch/nip66": "*",
    "dexie": "4.0.8",
    "fastq": "1.17.1",
    "queue": "7.0.0"
  },
  "peerDependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandwichfarm/nostrwatch.git"
  },
  "bugs": {
    "url": "https://github.com/sandwichfarm/nostrwatch/issues"
  },
  "homepage": "https://github.com/sandwichfarm/nostr-watch/tree/next/libraries/nip66/adapters/cache/DexieAdapter/#readme"
}

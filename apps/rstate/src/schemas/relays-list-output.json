{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "relays": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Relay URL (format=simple)"
          },
          {
            "type": "object",
            "description": "RelayState object (format=full or format=detailed)",
            "additionalProperties": true
          }
        ]
      }
    },
    "total": {
      "type": "number"
    },
    "limit": {
      "type": "number"
    },
    "offset": {
      "type": "number"
    }
  },
  "required": ["relays", "total", "limit", "offset"]
}

{
  "name": "@nostrwatch/relay-chronicle",
  "version": "1.0.0",
  "description": "Chronicle relay history and state from NIP-66 Kind 1066 delta events",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "browser": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && node build.js && npm run build:types",
    "build:types": "tsc --project tsconfig.build.json",
    "build:test": "npm run build && node test-build.mjs && node test-build.cjs",
    "clean": "rm -rf dist",
    "test": "deno test --allow-read",
    "test:all": "npm test && npm run build:test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nostr",
    "nip-66",
    "relay",
    "monitoring",
    "state-composition",
    "delta-events",
    "kind-1066",
    "typescript"
  ],
  "author": "nostr.watch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nostr-watch/relaymon.git",
    "directory": "libraries/relay-chronicle"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

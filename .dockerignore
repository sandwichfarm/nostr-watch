# Exclude everything by default
*

# Include relaymon app
!apps/relaymon/

# Include trawler app
!apps/trawler/

# Include docker-stacks (s6-services, compose files, configs)
!apps/docker-stacks/

# Include workspace dependencies (referenced by apps deno.json import maps)
!libraries/nocap/
!libraries/websocket/
!libraries/db/
!libraries/nostrings/
!libraries/nostrawl/
!internal/utils/
!internal/publisher/
!internal/logger/
!internal/announce/

# Re-exclude heavy/unnecessary content in included dirs
**/node_modules/
**/dist/
**/tests/
**/*.db
**/*.env*

{
    "compilerOptions": {
      "lib": ["deno.ns", "deno.window", "esnext"],
      "strict": true,
      "vendor": true,
    },
    "vendor": true,
    "nodeModulesDir": "auto",
    "tasks": {
      "force-refresh": "rm -rf node_modules && rm -f deno.lock && DENO_DIR=$(deno info --json | jq -r .denoDir) && rm -rf \"$DENO_DIR/npm\" && deno task start",
      "compile": "mkdir -p dist && deno compile --no-check --allow-ffi --unstable-sloppy-imports --allow-net --allow-env --allow-read --allow-write --allow-run --output dist/trawler src/main.ts",
      "start": "deno run --allow-sys --allow-ffi --unstable-sloppy-imports --allow-net --allow-env --allow-read --allow-write --allow-run src/main.ts",
      "test": "deno test --unstable-sloppy-imports --allow-net --allow-env --allow-read --allow-write --allow-run",
      "link:nocap": "bash -c 'REPO_ROOT=$(cd ../.. && pwd) && if ! [ -L ./node_modules/@nostrwatch/nocap ]; then ln -sfn \"$REPO_ROOT/libraries/nocap\" ./node_modules/@nostrwatch/nocap; fi'"
    },
    "fmt": {
      "files": {
        "include": ["**/*.ts", "**/*.js", "**/*.json", "**/*.yaml", "**/*.yml"]
      }
    },
    "lint": {
      "files": {
        "include": ["**/*.ts", "**/*.js"]
      }
    },
    "version": "0.2.0",
    "imports": {
      "nostr-geotags": "npm:nostr-geotags@0.7.2",

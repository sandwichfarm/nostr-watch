# Trawler — Application Configuration (trawler-relaymon-clearnet stack)
# Copy to trawler-config.yaml and customize before running docker compose up
#
# Trawler crawls nostr relay lists to discover new relays and writes them to its
# own database. RelayMon seeds from this database (read-only) on a separate DB path.

logLevel: info

trawler:
  logLevel: info
  db:
    path: /opt/data/trawler.db   # Trawler's own database (separate from relaymon)
    enableWAL: true
  relaysPerBatch: 5              # How many relays to query per batch
  concurrency: 2                 # Parallel crawl workers

  seed:
    interval: 60000              # Re-seed interval (ms)
    sources: ["config"]          # Seed from statically configured relay URLs
    options:
      allowedNetworks: ["clearnet"]
      config:
        - 'wss://relay.nostr.watch'
        - 'wss://purplepag.es'
        - 'wss://relaypag.es'

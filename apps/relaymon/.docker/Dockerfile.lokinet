FROM debian:bullseye-slim

# Handle resolv.conf first to prevent issues with resolvconf package
# Backup original resolv.conf
RUN cp /etc/resolv.conf /etc/resolv.conf.orig

# Install build dependencies and runtime dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    libsodium-dev \
    libzmq3-dev \
    libcurl4-openssl-dev \
    libuv1-dev \
    pkg-config \
    libunbound-dev \
    nettle-dev \
    libssl-dev \
    libevent-dev \
    libsqlite3-dev \
    curl \
    wget \
    gnupg \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Prevent resolvconf from modifying /etc/resolv.conf
RUN mkdir -p /etc/resolvconf/run/
RUN touch /etc/resolvconf/run/enable-updates
# Create a fake resolv.conf file for resolvconf to modify
RUN touch /etc/resolvconf/run/resolv.conf

# Add Oxen repository for Lokinet
RUN curl -s https://deb.oxen.io/pub.gpg | apt-key add - \
    && echo "deb https://deb.oxen.io bullseye main" > /etc/apt/sources.list.d/oxen.list \
    && apt-get update \
    # Install resolvconf with DEBIAN_FRONTEND=noninteractive to avoid prompts
    && DEBIAN_FRONTEND=noninteractive apt-get install -y resolvconf \
    # Now install lokinet
    && apt-get install -y lokinet \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Restore original resolv.conf
RUN cp /etc/resolv.conf.orig /etc/resolv.conf

# Create Lokinet configuration
RUN mkdir -p /var/lib/lokinet

# Configure Lokinet to run in the foreground
COPY .docker/scripts/bootstrap-lokinet.sh /usr/local/bin/bootstrap-lokinet.sh
RUN chmod +x /usr/local/bin/bootstrap-lokinet.sh

EXPOSE 9050

ENTRYPOINT ["/usr/local/bin/bootstrap-lokinet.sh"] 
# RelayMon — Environment Variables (trawler-relaymon-clearnet stack)
# Copy to relaymon.env and fill in your values before running docker compose up

# Signing key for publishing nostr events (NIP-66 relay monitor events)
# Required for publishing check results and announcements
# Accepts nsec1... bech32 or hex format
RELAYMON_NSEC=

# Optional: Uptime Kuma push monitoring
#RELAYMON_KUMA_PUSH_URL=https://uptime.example.com/api/push/YOUR_TOKEN
#RELAYMON_KUMA_BASE_URL=https://uptime.example.com
#RELAYMON_KUMA_TOKEN=

# Optional: Health server authentication token
#RELAYMON_HEALTH_AUTH_TOKEN=

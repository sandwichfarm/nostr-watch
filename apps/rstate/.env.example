# ========================================
# Transport Configuration
# ========================================
# Enable at least one transport method: CVM (Nostr MCP) or REST (HTTP API)

# CVM Transport (Nostr MCP over Nostr relays)
CVM_ENABLED=true

# REST API Transport (HTTP REST API)
REST_ENABLED=false

# ========================================
# CVM Transport Configuration
# ========================================
# Required only if CVM_ENABLED=true

# Server Transport Relays (comma-separated wss:// URLs)
CVM_RELAYS=wss://relay.damus.io,wss://relay.nostr.band

# Server Private Key (nsec or hex)
CVM_SERVER_NSEC=nsec1...

# Encryption Mode: OPTIONAL | REQUIRED | DISABLED
CVM_ENCRYPTION_MODE=OPTIONAL

# Allowed Pubkeys for Policy Mutations (comma-separated hex pubkeys, empty = no restrictions)
CVM_ALLOWED_PUBKEYS=

# Authentication Settings
CVM_AUTH_ENABLED=true
CVM_AUTH_ALLOW_ANY=false

# CEP-8 CVM Payments
CVM_PAYMENTS_ENABLED=false
CVM_NWC_CONNECTION_STRING=
# CVM_PRICING_YAML=./config/pricing.cvm.yaml  # optional CVM-specific overrides

# ========================================
# Ingestion Configuration (Always Required)
# ========================================
# Ingestion Relays for NIP-66 data (comma-separated wss:// URLs)
INGEST_RELAYS=wss://history.nostr.watch,wss://relay.nostr.watch

# Trusted Relay Assertions (kind 30385)
TRA_ENABLED=true
TRA_RELAYS=wss://nos.lol,wss://relay.damus.io,wss://relay.primal.net
TRA_PUBKEYS=ad3cdbe9fb09b8edf7b3e0e5286d66e58b58eaa64d061bbcf3a935edf8abf421

# Persistent state database and migration backups
STATE_DB_ENABLED=true
STATE_DB_PATH=./data/rstate-state.json
STATE_BACKUP_DIR=./data/backups
STATE_BACKUP_RETENTION=10

# ========================================
# Logging Configuration
# ========================================
LOG_LEVEL=info
LOG_DESTINATION=stdout
LOG_FILE=
LOG_ENABLED=true

# ========================================
# REST API Configuration
# ========================================
# Required only if REST_ENABLED=true
REST_HOST=127.0.0.1
REST_PORT=3000

# API Base URL for OpenAPI/Swagger spec
# Leave empty for development (will use http://REST_HOST:REST_PORT)
# Set to production URL for deployment (e.g., https://api.nostr.watch)
API_BASE_URL=

REST_CORS_ORIGINS=http://localhost:3000
REST_ENABLE_SWAGGER=true
REST_ALLOW_POLICY_UPDATE=false

# REST Rate Limiting
REST_RATE_LIMIT_ENABLED=true
REST_RATE_LIMIT_RPS=10
REST_RATE_LIMIT_BURST=100

# 402 Payments (feature flags)
FEATURE_402=false
FEATURE_402_L402=true
FEATURE_402_P2PK=false

# Pricing config (shared by CVM + REST)
# Unified pricing file — all endpoints with amounts in sats
PRICING_YAML=./config/pricing.yaml
# REST_PRICING_YAML=./config/pricing.rest.yaml  # optional REST-specific overrides

# L402 macaroon root key (64-hex)
L402_ROOT_KEY=

# LND REST
LND_REST_URL=https://127.0.0.1:8080
LND_MACAROON_HEX=

# LND gRPC (preferred for production)
LND_GRPC_HOST=127.0.0.1:10009
LND_TLS_CERT_PATH=/etc/lnd/tls.cert
LND_PROTO_DIR=/opt/lnd/lnrpc

# Redis for receipts (optional)
REDIS_URL=redis://127.0.0.1:6379

# Cashu (Nutshell) P2PK (optional)
CASHU_MINT_URL=https://mint.example.com
CASHU_ACCEPTED_MINTS=https://mint.example.com
CASHU_P2PK_PUBKEY=
# Private key only if server needs to sign challenges (optional)
CASHU_P2PK_PRIVATE_KEY=

# Aggregation Configuration (optional, defaults will be used)
# AGG_LOOKBACK_SECONDS=21600
# AGG_QUORUM=0.5
# AGG_LABEL_QUORUM=0.3
# AGG_MAD_SCALE=3.0

# Cache Configuration (optional, defaults will be used)
# CACHE_MAX_SIZE=10000
# CACHE_TTL_SECONDS=60

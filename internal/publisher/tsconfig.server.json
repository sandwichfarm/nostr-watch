{
  "compilerOptions": {
    "target": "es2022",
    "module": "ESNext",
    "lib": ["ES6", "DOM"],
    "moduleResolution": "bundler",

    "outDir": "./dist/server",
    "declarationDir": "./dist/server/types",

    "skipLibCheck": true,
    "declaration": true,

    "esModuleInterop": true,
    "sourceMap": true,

    "noEmitHelpers": true,
    "importHelpers": true,
    
    "strict": true,
    
    "baseUrl": ".", 
    "paths": {
      "@nostrwatch/*": ["node_modules/@nostrwatch/*/src"],
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "adapters"],
  "tsc-alias": {
    "resolveFullPaths": true,
    "resolveFullExtension": ".js"
  }
}

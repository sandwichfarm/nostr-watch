{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "relays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "RelayState objects with distance field"
    },
    "center": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" }
      },
      "required": ["lat", "lon"]
    },
    "radius": { "type": "number" }
  },
  "required": ["relays", "center", "radius"]
}

{
  "name": "@nostrwatch/nip66-cacheadapter-nostrsqlite",
  "type": "module",
  "packageManager": "yarn@4.5.0",
  "main": "dist/browser/index.js",
  "dependencies": {
    "@nostrwatch/nip66": "workspace:^",
    "@nostrwatch/worker-relay": "workspace:^"
  },
  "devDependencies": {
    "@chialab/esbuild-plugin-meta-url": "^0.18.2",
    "@chialab/esbuild-plugin-worker": "^0.18.1",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@jgoz/esbuild-plugin-livereload": "^2.1.2",
    "esbuild": "^0.24.0",
    "esbuild-plugin-alias": "^0.2.1",
    "esbuild-plugin-clean": "^1.0.1",
    "esbuild-plugin-inline-worker": "^0.1.1",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "esbuild-plugin-tsc": "^0.4.0",
    "esbuild-plugin-wasm": "^1.1.0",
    "get-port": "^7.1.0",
    "tsc": "^2.0.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-node-polyfills": "^0.22.0"
  },
  "scripts": {
    "build": "yarn clean && tsc && yarn build:esm",
    "build:esm": "node esbuild.js",
    "dev": "node esbuild.js",
    "clean": "rm -rf dist",
    "clean:source": "find src -name \"*.d.ts\" -type f -delete && find src -name \"*.d.ts.map\" -type f -delete",

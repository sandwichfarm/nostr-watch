{
  "name": "@nostrwatch/relay-chronicle",
  "version": "1.0.0",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --allow-read",
    "build": "deno run -A npm:esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js"

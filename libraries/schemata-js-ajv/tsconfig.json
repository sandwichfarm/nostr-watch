{
    "compilerOptions": {
      "target": "ESNext",
      "module": "node16",
      "moduleResolution": "node16",
      "esModuleInterop": true,
      "declaration": true,
      "declarationDir": "./dist",
      "emitDeclarationOnly": true,
      "strict": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "allowJs": true,
      "resolveJsonModule": true,
      "isolatedModules": true,
      "outDir": "./dist", 
      "rootDir": "./src"
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
  }
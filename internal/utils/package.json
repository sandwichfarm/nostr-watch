{
  "name": "@nostrwatch/utils",
  "version": "0.1.9",
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "main": "dist/server/index.cjs.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/server/index.esm.js",
        "require": "./dist/server/index.cjs.js"
      },
      "browser": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/browser/index.esm.js"
      },
      "default": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/browser/index.esm.js"
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && rollup -c && pnpm run build:types",
    "build:types": "tsc -p tsconfig.web.json --emitDeclarationOnly",
    "dev": "rollup -c --watch",
    "dev:server": "pnpm run dev",
    "dev:web": "pnpm run dev",
    "test": "vitest",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "dotenv": "16.3.1",
    "rollup": "^4.24.0",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@noble/hashes": "1.5.0",
    "nostr-tools": "2.11.0",
    "@rollup/plugin-alias": "5.1.1",
    "@rollup/plugin-commonjs": "28.0.0",
    "@rollup/plugin-node-resolve": "15.3.0",
    "@rollup/plugin-replace": "6.0.1",
    "@rollup/plugin-terser": "0.4.4",
    "@surma/rollup-plugin-off-main-thread": "2.2.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "esbuild-plugin-alias": "0.2.1",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "glob": "^10.0.0",
    "node-polyfill-webpack-plugin": "4.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^5.0.0",
    "rollup-plugin-livereload": "2.0.5",
    "rollup-plugin-polyfill-node": "0.13.0",
    "rollup-plugin-typescript2": "0.36.0",
    "rollup-plugin-web-worker-loader": "1.6.1",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^0.34.1",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "files": [
    "dist/**/*"
  ],
  "peerDependencies": {
    "nostr-tools": ">=2.0.0",
    "@noble/hashes": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "nostr-tools": { "optional": true },
    "@noble/hashes": { "optional": true }
  },
  "engines": {
    "node": ">=14.0.0"
  }
}

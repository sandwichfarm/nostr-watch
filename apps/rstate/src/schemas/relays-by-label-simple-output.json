{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "relays": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Relay URLs"
    },
    "label": {
      "type": "object",
      "properties": {
        "namespace": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["namespace", "value"]
    },
    "total": { "type": "number" }
  },
  "required": ["relays", "label", "total"]
}

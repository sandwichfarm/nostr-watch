{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "relays": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Relay URL (format=simple)"
          },
          {
            "type": "object",
            "description": "RelayState object (format=full or format=detailed)",
            "additionalProperties": true
          }
        ]
      }
    },
    "bbox": {
      "type": "object",
      "properties": {
        "sw": {
          "type": "object",
          "properties": { "lat": { "type": "number" }, "lon": { "type": "number" } },
          "required": ["lat", "lon"]
        },
        "ne": {
          "type": "object",
          "properties": { "lat": { "type": "number" }, "lon": { "type": "number" } },
          "required": ["lat", "lon"]
        }
      },
      "required": ["sw", "ne"]
    },
    "total": { "type": "number" }
  },
  "required": ["relays", "bbox", "total"]
}

